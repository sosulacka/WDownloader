    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "~2.7.1",
    "astro": "^7.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
